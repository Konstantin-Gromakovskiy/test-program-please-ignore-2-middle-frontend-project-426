{
  "type": "module",
  "imports": {
    "#routes/*": "./dist/routes/*.js",
    "#db/*": "./dist/db/*",
    "#domain/*": "./dist/domain/*",
    "#lib/*": "./dist/lib/*",
    "#service/*": "./dist/services/*",
    "#repository/*": "./dist/repositories/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "dev": "node --env-file=../.env --import tsx --watch app.ts",
    "start": "node dist/app.js",
    "db:setup": "node --env-file=../.env --import tsx db/setup.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "openapi-ts": "openapi-ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/request-context": "^7.0.0",
    "@fastify/sensible": "^6.0.5",
    "@fastify/static": "^10.1.3",
    "@pc-store/contract": "file:../contract",
    "@sentry/node": "^10.73.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^1.0.0-rc.4",
    "drizzle-orm": "^1.0.0-rc.4",
    "fastify": "^5.12.1",
    "fastify-openapi-glue": "^4.11.5",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
