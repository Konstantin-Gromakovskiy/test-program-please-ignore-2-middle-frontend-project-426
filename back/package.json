{
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file=../.env --import tsx --watch app.ts",
    "start": "node --env-file=.env dist/app.js",
    "db:migrate": "NODE_OPTIONS=\"--env-file=../.env\" npx drizzle-kit migrate",
    "db:generate": "NODE_OPTIONS=\"--env-file=../.env\" npx drizzle-kit generate",
    "db:push": "NODE_OPTIONS=\"--env-file=../.env\" npx drizzle-kit push"
  },
  "dependencies": {
    "@fastify/request-context": "^7.0.0",
    "@fastify/static": "^10.1.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "fastify": "^5.12.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^1.0.0-rc.4",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
